{
  "Function Definition": {
    "prefix": "fn",
    "body": [
      "fn ${1:function_name}(${2:params}) -> ${3:return_type} {",
      "    ${0:// implementation}",
      "}"
    ],
    "description": "Define a typed EraLang function"
  },
  "Struct Declaration": {
    "prefix": "struct",
    "body": [
      "struct ${1:StructName} {",
      "    ${2:field_name}: ${3:type}",
      "}"
    ],
    "description": "Define an EraLang Struct"
  },
  "Enum Declaration": {
    "prefix": "enum",
    "body": [
      "enum ${1:EnumName} {",
      "    ${2:VariantA},",
      "    ${3:VariantB}",
      "}"
    ],
    "description": "Define an EraLang Enum"
  },
  "Exhaustive Match": {
    "prefix": "match",
    "body": [
      "match ${1:expression} {",
      "    Some(${2:val}) => ${3:print(val)}",
      "    None => ${4:print(\"None\")}",
      "}"
    ],
    "description": "Exhaustive Pattern Match"
  },
  "Tensor Matrix Multiplication": {
    "prefix": "tensor",
    "body": [
      "let ${1:A} = Tensor.from_array([[1.0, 0.0], [0.0, 1.0]])",
      "let ${2:B} = Tensor.from_array([[2.0, 3.0], [4.0, 5.0]])",
      "let ${3:C} = ${1:A} @ ${2:B}"
    ],
    "description": "Create and multiply native Tensors"
  }
}
