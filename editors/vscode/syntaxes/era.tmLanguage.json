{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "EraLang",
  "scopeName": "source.era",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.era",
          "match": "//.*$"
        },
        {
          "name": "comment.block.era",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.era",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.era",
          "match": "\\\\."
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.era",
          "match": "\\b(if|else|match|for|in|while|break|continue|return|spawn)\\b"
        },
        {
          "name": "keyword.declaration.era",
          "match": "\\b(let|var|fn|struct|enum|actor|import|as)\\b"
        },
        {
          "name": "keyword.other.era",
          "match": "\\b(ai)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.era",
          "match": "\\b(int|float|string|bool|void|Option|Result|Tensor|Chan|Actor|Map|Array)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.era",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.option.era",
          "match": "\\b(Some|None|Ok|Err)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.era",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.era",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.era",
          "match": "(\\+|\\-|\\*|/|%|@)"
        },
        {
          "name": "keyword.operator.comparison.era",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.era",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arrow.era",
          "match": "(->|=>|\\.\\.<|\\.\\.)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.era"
        }
      ]
    }
  }
}
