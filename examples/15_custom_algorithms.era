// examples/15_custom_algorithms.era
// Classic Binary Search implementation with Safe Bounds & Option<T>

fn binary_search(arr: [int], target: int) -> Option {
    var low = 0
    var high = len(arr) - 1

    while low <= high {
        let mid = (low + high) / 2
        // EraLang safe indexing returns Option<int>, unwrap_or handles bounds safely
        let mid_val = arr[mid].unwrap_or(-1)

        if mid_val == target {
            return Some(mid)
        }
    if mid_val < target {
        low = mid + 1
    } else {
    high = mid - 1
}
}
return None
}

let sorted_data = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]
let search_targets = [23, 72, 99]

var i = 0
while i < len(search_targets) {
    let t = search_targets[i].unwrap_or(0)
    let result = binary_search(sorted_data, t)
    match result {
        Some(idx) => print("Found target " + to_str(t) + " at index: " + to_str(idx))
        None => print("Target " + to_str(t) + " not found in array.")
    }
i = i + 1
}
